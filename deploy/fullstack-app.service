# ============================================================
# systemd 服务 — 守护 FastAPI 后端进程
# 放到: /etc/systemd/system/fullstack-app.service
# ============================================================
# 部署步骤:
#   1. sudo cp deploy/fullstack-app.service /etc/systemd/system/
#   2. sudo systemctl daemon-reload
#   3. sudo systemctl enable fullstack-app
#   4. sudo systemctl start fullstack-app
#   5. sudo systemctl status fullstack-app
# ============================================================
[Unit]
Description=Fullstack App — FastAPI Backend
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/fullstack-app/backend
EnvironmentFile=-/var/www/fullstack-app/backend/.env
ExecStart=/var/www/fullstack-app/backend/venv/bin/uvicorn app.main:app \
          --host 127.0.0.1 \
          --port 8000 \
          --workers 4
Restart=always
RestartSec=3

# 安全性加固
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
