# 复制成 backend/.env 后修改（.env 不进 git，服务器上需要手动创建）
# 本地开发: sqlite:///./app.db
# 容器内:   sqlite:////app/data/app.db （由 docker-compose 注入，不要在这里改）
DATABASE_URL=sqlite:///./app.db

# 签发登录令牌用，生产环境必须换成随机串，例如: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production

# 后台 /admin 的登录密码
ADMIN_PASSWORD=change-me
